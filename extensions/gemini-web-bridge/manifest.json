{
  "manifest_version": 3,
  "name": "Delegator Gemini Bridge",
  "version": "0.22.3",
  "description": "Sends selected Delegator chat requests to dedicated signed-in web chat tabs: Gemini, AI Studio, Kimi, Z.ai, Qwen, DeepSeek, Tencent Hy, Rudder.",
  "permissions": [
    "alarms",
    "tabs",
    "tabGroups",
    "scripting",
    "debugger",
    "storage"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*",
    "https://www.kimi.ai/*",
    "https://kimi.ai/*",
    "https://chat.z.ai/*",
    "https://chat.qwen.ai/*",
    "https://chat.deepseek.com/*",
    "https://rudder.chat/*",
    "https://aistudio.tencent.ai/*",
    "http://127.0.0.1:1380/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/app*",
        "https://aistudio.google.com/*",
        "https://www.kimi.ai/*",
        "https://kimi.ai/*",
        "https://chat.z.ai/*",
        "https://chat.qwen.ai/*",
        "https://chat.deepseek.com/*",
        "https://rudder.chat/*",
        "https://aistudio.tencent.ai/*"
      ],
      "js": [
        "visible.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://gemini.google.com/app*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
